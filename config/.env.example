# Application
APP_NAME=allease-engineering-assistant
ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM provider (Groq, serving Llama 3.3 70B)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Postgres (metadata DB)
# Host port is 55432 (not the default 5432) to avoid colliding with any
# locally-installed Postgres already running on this machine.
DATABASE_URL=postgresql+psycopg://allease:allease@localhost:55432/allease

# Vector DB (Chroma for now; swappable via VECTOR_STORE_PROVIDER)
VECTOR_STORE_PROVIDER=chroma
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Observability (LangSmith)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=allease-engineering-assistant
